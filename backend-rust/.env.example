# Lycoris Rust 后端环境变量示例（由启动工具加载，或逐项导出；不要提交真实凭据）
# 二进制本身不自动读取 .env；仅复制文件不会把变量传给 cargo run / 可执行程序。
#
# 只有 DATABASE_URL / REDIS_URL 必填；其余留空即使用安全默认。完整说明见 backend-rust/README.md
# 「配置项」与「数据库超时与密码并发」两节。

# —— 基础连接（必填；仅校验格式，启动日志不打印）——
DATABASE_URL=postgres://lycoris:lycoris_local_test@127.0.0.1:55432/lycoris_rust
REDIS_URL=redis://127.0.0.1:56379

# —— HTTP 监听与上传 ——
SERVER_HOST=127.0.0.1
SERVER_PORT=18081
UPLOAD_DIR=uploads

# —— 并发许可 ——
# 图片 CPU 处理并发（默认 1，必须正值）；无许可立即 503。
MEDIA_MAX_CONCURRENCY=1
# BCrypt 阻塞任务并发（默认按 CPU 数 clamp 1..=4；显式只接受 1..=32）。
PASSWORD_MAX_CONCURRENCY=4

# —— 数据库连接池（服务连接）——
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECONDS=30
DB_MAX_LIFETIME_SECONDS=1800
DB_IDLE_TIMEOUT_SECONDS=600
# 服务连接语句超时（毫秒，1..=300000，默认 20000）；超时受控映射 503。
# 仅普通启动（Serve）使用；--migrate/--check-baseline/--adopt-baseline 使用独立维护策略，不继承本值。
# 维护命令固定使用独立 lock_timeout=5000ms 约束迁移/接管锁等待；--migrate 在独占物理连接上执行。
DB_STATEMENT_TIMEOUT_MS=20000
# 服务连接锁等待超时（毫秒，1..=300000，默认 5000）；锁超时同样受控映射 503。
DB_LOCK_TIMEOUT_MS=5000

# —— 请求与来源 ——
REQUEST_TIMEOUT_SECONDS=30
APP_AVAILABILITY_ZONE=Asia/Shanghai
CORS_ALLOWED_ORIGINS=
# 未配置时回落到 CORS_ALLOWED_ORIGINS。
WRITE_ALLOWED_ORIGINS=
TRUSTED_PROXIES=

# —— 查询缓存 ——
MARKER_CACHE_REDIS_ENABLED=true
MARKER_CACHE_NAMESPACE=lycoris:rust:marker

# —— 会话与 Cookie（与 Java 并行验收时建议独立命名）——
SESSION_COOKIE_NAME=LYCORIS_SESSION
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_MAX_AGE_SECONDS=2592000
SESSION_TTL_SECONDS=2592000
SECOND_FACTOR_TTL_SECONDS=1800
SESSION_NAMESPACE=lycoris:rust:session:v1
RATE_LIMIT_NAMESPACE=lycoris:rust:ratelimit:v1
REDIS_COMMAND_TIMEOUT_SECONDS=2

# —— 注册限流与密码 ——
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=600
BCRYPT_COST=10
ADMIN_SECOND_FACTOR_ENABLED=true
# 必须是 BCrypt 编码串（$2a$/$2b$/$2y$ 前缀）；纯文本启动即拒绝。
ADMIN_SECOND_PASSWORD_HASH=
# 生产部署请显式设置。
ADMIN_DEFAULT_USER_PASSWORD=Lycoris123!
