# Browser-side Tianditu key. Copy to .env.local for local builds.
# Set the same variable in Cloudflare Pages production and preview builds.
# VITE_* values are public in the built browser application.
VITE_TIANDITU_API_KEY=
# Tencent JavaScript API GL browser key; also set in Pages build variables.
VITE_TENCENT_MAP_KEY=
