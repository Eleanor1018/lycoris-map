# Production PostgreSQL 17, retaining the source database major version.
ARG PG_BASE=postgres:17.11-bookworm@sha256:051f7b7b3abdd564d5d1bd1e8c4b9c1b6e77087d1dd22020ede611c096a272e0
FROM ${PG_BASE}

ARG POSTGIS_PKG_VERSION=3.6.4+dfsg-2.pgdg12+1

USER root
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        "postgresql-17-postgis-3=${POSTGIS_PKG_VERSION}" \
        "postgresql-17-postgis-3-scripts=${POSTGIS_PKG_VERSION}"; \
    rm -rf /var/lib/apt/lists/*

