# Lycoris 阶段 4 演练入口（Nginx）模板。
# 由 scripts/check-rehearsal.py 渲染到 <work-dir>/nginx/conf.d/entry.conf，
# 通过替换 __ACTIVE_BACKEND__ 指向 java:8080 或 rust:8080 完成同入口切换；
# 每次 reload 前必须 `nginx -t`。
#
# 说明：使用 Docker 内置 DNS（127.0.0.11）+ 变量 proxy_pass，使未启动的后端
# 不会阻止 Nginx 启动；只在请求到达时解析当前活动后端。

resolver 127.0.0.11 valid=5s ipv6=off;

server {
    listen 80;
    server_name _;
    client_max_body_size 10m;

    location = /health/rehearsal {
        default_type text/plain;
        return 200 'ok';
    }

    location / {
        set $active_backend "__ACTIVE_BACKEND__";
        proxy_pass http://$active_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_connect_timeout 15s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
