# Lycoris 阶段 4 演练入口维护态：冻结同入口写操作，全部 503（健康探针除外）。
# 由 switching.freeze_entry 渲染到 <work-dir>/nginx/conf.d/entry.conf。

server {
    listen 80;
    server_name _;
    client_max_body_size 10m;

    location = /health/rehearsal {
        default_type text/plain;
        return 200 'maintenance';
    }

    location / {
        default_type text/plain;
        return 503 'maintenance';
    }
}
