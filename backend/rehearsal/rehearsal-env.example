# Lycoris 阶段 4 演练环境变量样例（全部合成，无真实凭据）。
# 实际 .env 由 scripts/check-rehearsal.py 写到可追踪的临时演练目录，不手工提交。
# 本文件以 rehearsal-env.example 命名，避免与受保护的 .env / .env.* 混淆。
#
# 严禁填入生产/真实凭据；报告与日志不打印口令与 Cookie。

# 演练临时根目录（所有报告、上传、导出、Nginx 配置都在其下）。
REHEARSAL_WORK_DIR=C:/Users/Nora/AppData/Local/Temp/lycoris-rust-rehearsal

# 合成数据库用户与口令（仅本地回环演练；仅供 compose 的 POSTGRES/Java/Rust 使用）。
PG_REHEARSAL_USER=lycoris_rehearsal
PG_REHEARSAL_PASSWORD=rehearsal-synth-01

# 演练 Web Origin 白名单（明确列表；Android 原生 API 无 Origin，另行放行）。
REHEARSAL_WEB_ORIGINS=http://localhost:5198,http://127.0.0.1:5198

# 主机侧 guard 校验用的连接串（只读；外部工具仅回环端口 + 合成库）。
PG17_URL=postgres://lycoris_rehearsal:rehearsal-synth-01@127.0.0.1:55435/lycoris_rehearsal_src
PG18_URL=postgres://lycoris_rehearsal:rehearsal-synth-01@127.0.0.1:55434/lycoris_rehearsal_up
REDIS_URL=redis://127.0.0.1:56380
ENTRY_URL=http://127.0.0.1:18180

# Java / Rust 容器内部连接（服务名，仅专用网络内部）。
JAVA_DB_URL=jdbc:postgresql://pg18:5432/lycoris_rehearsal_up
RUST_DATABASE_URL=postgres://lycoris_rehearsal:rehearsal-synth-01@pg18:5432/lycoris_rehearsal_up
RUST_REDIS_URL=redis://redis:6379

# 非 root 运行的应用 UID/GID（Java 与 Rust 统一 10001，共用上传目录同属主可写）。
REHEARSAL_APP_UID=10001
REHEARSAL_APP_GID=10001

# 前置依赖（交付后填写；缺失时对应步骤报 blocked，不假称成功）。
# 温晓在原 Java 未改代码构建的平台无关 JAR：
JAVA_JAR_PATH=C:/Users/Nora/lycoris/backend-old/target/demo-1.0.3.jar
# Linux Rust release 镜像（本任务不构建）：
RUST_REHEARSAL_IMAGE=

# PG17 fixture 构建可覆写为同 digest 的可信镜像源（默认已固定 digest）。
# PG17_REHEARSAL_BASE=docker.m.daocloud.io/postgres:17.11-bookworm@sha256:051f7b7b3abdd564d5d1bd1e8c4b9c1b6e77087d1dd22020ede611c096a272e0

# 公平性能开关（默认缓存开；关闭时明确记录）。
MARKER_CACHE_REDIS_ENABLED=true

# 合成管理员默认重置口令（仅演练）。
ADMIN_DEFAULT_USER_PASSWORD=Lycoris123!
